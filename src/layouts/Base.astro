---
import '../styles/brand.css';
import '../styles/site.css';
import '../styles/effects.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CallModal from '../components/CallModal.astro';
import { SITE, SITE_NAME } from '../config';
import {
  siteGraph,
  breadcrumbLd,
  absoluteUrl,
  DEFAULT_OG_IMAGE,
  LOCALE,
  DEFAULT_ROBOTS,
  THEME_COLOR,
  TWITTER_HANDLE,
  GOOGLE_SITE_VERIFICATION,
} from '../lib/seo';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Dimensioni reali dell'immagine social: aiutano gli scraper a renderizzare subito la card. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogType?: string;
  active?: string;
  robots?: string;
  /** Breadcrumb per le pagine di dettaglio: [{ name, url }]. */
  breadcrumbs?: { name: string; url: string }[];
  /** Structured data aggiuntivi (Article, Event, ItemList…). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = 'Andrea Bellettati — Comunicazione Cinofila',
  ogImageWidth,
  ogImageHeight,
  ogImageType = 'image/jpeg',
  ogType = 'website',
  active,
  robots = DEFAULT_ROBOTS,
  breadcrumbs,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImageAbs = absoluteUrl(ogImage);

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    ...(breadcrumbs?.length ? [breadcrumbLd(breadcrumbs)] : []),
    ...extra,
  ],
};

const fontHref =
  'https://fonts.googleapis.com/css2?family=Anton&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600;700&family=Caveat:wght@600;700&family=Cormorant+Garamond:ital,wght@1,500;1,600&family=JetBrains+Mono:wght@400&display=swap';

// Speculation Rules API: prefetch dei documenti interni (warm-up del navigatore).
const speculationRules = JSON.stringify({
  prefetch: [{ source: 'document', where: { href_matches: '/*' }, eagerness: 'moderate' }],
});
---
<!doctype html>
<html lang="it" data-titlestyle="poster" data-paper="on">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/assets/logo-andrea.jpg" />
    <link rel="apple-touch-icon" href="/assets/logo-andrea.jpg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="generator" content={Astro.generator} />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:secure_url" content={ogImageAbs} />
    <meta property="og:image:type" content={ogImageType} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE} />
    <meta property="og:site_name" content={SITE_NAME} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {TWITTER_HANDLE && <meta name="twitter:site" content={TWITTER_HANDLE} />}

    <!-- Google Fonts: Anton, Inter, Caveat, Playfair Display, Cormorant Garamond, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <script type="speculationrules" is:inline set:html={speculationRules} />

    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="brand paper-bg">
    <a class="skip-link" href="#contenuto">Salta al contenuto</a>
    <SiteHeader active={active} />
    <main id="contenuto">
      <slot />
    </main>
    <SiteFooter />
    <CallModal />
    <button class="to-top" data-to-top type="button" aria-label="Torna all'inizio della pagina">
      <svg class="to-top-ring" viewBox="0 0 36 36" aria-hidden="true">
        <circle class="ring-bg" cx="18" cy="18" r="16"></circle>
        <circle class="ring-fg" cx="18" cy="18" r="16" data-ring></circle>
      </svg>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 19V5m0 0-6 6m6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
