---
import { SITE_TAGLINE, WA_LINK, IG_URL, IG_HANDLE } from '../config';
import WhatsAppIcon from './WhatsAppIcon.astro';
import InstagramIcon from './InstagramIcon.astro';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  active?: string;
}
const { active } = Astro.props;

// Su desktop la barra tiene quattro voci corte; i due flussi del sito
// ("Lavora con noi" e "Consulenza gratuita") stanno a destra come bottoni,
// sempre in vista. Nel menu mobile compaiono tutte le voci (mobile: true =
// solo lì) e in fondo le due azioni.
const nav = [
  { href: '/', label: 'Home', key: 'home', mobile: true },
  { href: '/approccio', label: 'Approccio', key: 'approccio' },
  { href: '/chi-sono', label: 'Chi sono', key: 'chi-sono' },
  { href: '/consulenza-gratuita', label: 'Consulenza gratuita', key: 'consulenza', mobile: true },
  { href: '/lavora-con-noi', label: 'Lavora con noi', key: 'lavora', work: true },
  { href: '/articoli', label: 'Blog', key: 'articoli' },
  { href: '/eventi', label: 'Eventi', key: 'eventi' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand-lockup" href="/" aria-label="Andrea Bellettati — home">
      <span class="lockup-mark">
        <img
          src="/assets/logo.jpg"
          alt="Ritratto di Andrea Bellettati con la sua bassotta"
          width="42"
          height="42"
        />
      </span>
      <span class="lockup-text">
        <span class="lockup-name">Andrea Bellettati</span>
        <span class="lockup-tag">{SITE_TAGLINE}</span>
      </span>
    </a>
    <nav class="site-nav" data-nav aria-label="Navigazione principale">
      {
        nav.map((item, i) => (
          <a
            href={item.href}
            style={`--i:${i}`}
            class:list={[{ 'nav-work': item.work, 'nav-mobile': item.mobile, active: active === item.key }]}
            aria-current={active === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <!-- Solo nel menu mobile: le due azioni e i contatti in fondo al foglio. -->
      <div class="nav-foot">
        <a class="btn btn-cream" href="/consulenza-gratuita#questionario">
          Prenota la consulenza gratuita <ArrowIcon size={15} />
        </a>
        <a class="btn btn-accent" href="/lavora-con-noi#candidatura">Lavora con noi</a>
        <a class="btn btn-ghost-cream" href={WA_LINK} target="_blank" rel="noopener">
          <WhatsAppIcon size={16} /> WhatsApp
        </a>
        <a class="nav-ig" href={IG_URL} target="_blank" rel="noopener">
          <InstagramIcon size={18} />
          {IG_HANDLE}
        </a>
      </div>
    </nav>
    <div class="header-actions">
      <a class="header-icon header-ig" href={IG_URL} target="_blank" rel="noopener" aria-label="Instagram di Andrea Bellettati">
        <InstagramIcon size={18} />
      </a>
      <a class="header-icon header-wa" href={WA_LINK} target="_blank" rel="noopener" aria-label="Scrivi ad Andrea su WhatsApp">
        <WhatsAppIcon size={18} />
      </a>
      <a class="btn btn-sm btn-ghost-accent header-work" href="/lavora-con-noi">Lavora con noi</a>
      <a class="btn btn-sm header-cta" href="/consulenza-gratuita#questionario">
        Consulenza gratuita <ArrowIcon size={14} />
      </a>
      <button class="nav-toggle" data-nav-toggle aria-label="Apri menu" aria-expanded="false">
        <span />
        <span />
        <span />
      </button>
    </div>
  </div>
</header>
