---
import { SITE_TAGLINE, LANDING_MODE, WA_LINK, IG_URL } from '../config';
import WhatsAppIcon from './WhatsAppIcon.astro';
import InstagramIcon from './InstagramIcon.astro';

interface Props {
  active?: string;
}
const { active } = Astro.props;

// "Lavora con noi" ha un trattamento visivo distinto (pill outline pesca):
// deve saltare all'occhio senza competere con la CTA WhatsApp.
const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/approccio', label: 'Il mio approccio', key: 'approccio' },
  { href: '/consulenza-gratuita', label: 'Consulenza gratuita', key: 'consulenza' },
  { href: '/lavora-con-noi', label: 'Lavora con noi', key: 'lavora', work: true },
  { href: '/articoli', label: 'Blog', key: 'articoli' },
  { href: '/chi-sono', label: 'Chi sono', key: 'chi-sono' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand-lockup" href="/" aria-label="Andrea Bellettati — home">
      <span class="lockup-mark">
        <img
          src="/assets/logo-original.jpg"
          alt="Ritratto di Andrea Bellettati con il suo bassotto"
          width="42"
          height="42"
        />
      </span>
      <span class="lockup-text">
        <span class="lockup-name">Andrea Bellettati</span>
        <span class="lockup-tag">{SITE_TAGLINE}</span>
      </span>
    </a>
    {
      LANDING_MODE ? (
        <a class="btn btn-sm header-cta" href={WA_LINK} target="_blank" rel="noopener">
          <WhatsAppIcon size={16} /> <span class="cta-label">WhatsApp</span>
        </a>
      ) : (
        <Fragment>
          <nav class="site-nav" data-nav aria-label="Navigazione principale">
            {nav.map((item) => (
              <a
                href={item.href}
                class={
                  [item.work ? 'nav-work' : null, active === item.key ? 'active' : null]
                    .filter(Boolean)
                    .join(' ') || undefined
                }
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
          <div class="header-actions">
            <a
              class="header-ig"
              href={IG_URL}
              target="_blank"
              rel="noopener"
              aria-label="Instagram di Andrea Bellettati"
            >
              <InstagramIcon size={18} />
            </a>
            <a class="btn btn-sm header-cta" href={WA_LINK} target="_blank" rel="noopener">
              <WhatsAppIcon size={16} /> <span class="cta-label">WhatsApp</span>
            </a>
            <button class="nav-toggle" data-nav-toggle aria-label="Apri menu" aria-expanded="false">
              <span />
              <span />
              <span />
            </button>
          </div>
        </Fragment>
      )
    }
  </div>
</header>
