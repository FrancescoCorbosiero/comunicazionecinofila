---
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from './ArrowIcon.astro';
import { autoCover } from '../lib/images';

interface Props {
  entry: CollectionEntry<'articoli'>;
}
const { entry } = Astro.props;
const d = entry.data;
// Cover dal frontmatter, oppure auto-rilevata (articolo-<slug>.* in public/assets).
const cover = autoCover('articolo', entry.id, d.cover);
const comingSoon = d.status === 'coming-soon';
// Senza foto, la card diventa un blocco colorato con la categoria: ogni
// categoria ha il suo colore, così nel blog si riconoscono a colpo d'occhio.
const TONE_BY_CATEGORY: Record<string, 'peach' | 'sage' | 'mist' | 'ink'> = {
  Alimentazione: 'peach',
  Comportamento: 'sage',
  Osservazione: 'ink',
  Gatto: 'mist',
  Benessere: 'mist',
};
const tone = TONE_BY_CATEGORY[d.category] ?? 'mist';
const external = Boolean(d.externalUrl);
const href = d.externalUrl ?? (comingSoon ? null : `/articoli/${entry.id}`);
const Tag = href ? 'a' : 'div';
// Tempo di lettura stimato (~200 parole/min) dal corpo Markdown.
const minutes = Math.max(1, Math.round((entry.body ?? '').trim().split(/\s+/).length / 200));
// Indice per la ricerca client-side: minuscolo e senza accenti,
// la stessa normalizzazione applicata alla query in site.ts.
const searchIndex = [d.title, d.excerpt, d.category]
  .join(' ')
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '');
---
<Tag
  class="card"
  data-cat={d.category}
  data-search={searchIndex}
  {...href ? { href } : {}}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  {
    cover ? (
      <div
        class="card-media"
        transition:name={comingSoon || external ? undefined : `art-img-${entry.id}`}
      >
        <img src={cover} alt={d.coverAlt ?? d.title} loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class={`card-media card-media--tone tone-${tone}`} aria-hidden="true">
        <span class="cm-word">{d.category}</span>
        <svg class="cm-paw" viewBox="0 0 50 44" fill="currentColor">
          <ellipse cx="12" cy="15" rx="4.3" ry="5.8" />
          <ellipse cx="21" cy="10" rx="4.3" ry="6" />
          <ellipse cx="30" cy="11" rx="4.3" ry="6" />
          <ellipse cx="38.5" cy="16" rx="4.3" ry="5.6" />
          <ellipse cx="25" cy="29" rx="9.5" ry="8" />
        </svg>
      </div>
    )
  }
  <div class="card-body">
    <div class="card-meta">
      {d.category}
      {comingSoon ? (
        <Fragment>
          {' · '}
          <span style="color:var(--peach-deep);">In arrivo</span>
        </Fragment>
      ) : (
        <Fragment>{` · ${minutes} min`}</Fragment>
      )}
    </div>
    <h3 style="font-size:23px;" transition:name={comingSoon ? undefined : `art-${entry.id}`}>
      {d.title}
    </h3>
    <p style="font-size:15.5px; margin:0;">{d.excerpt}</p>
    {
      comingSoon ? (
        <span class="text-link" style="margin-top:auto; opacity:0.55; cursor:default;">
          Presto disponibile
        </span>
      ) : (
        <span class="text-link" style="margin-top:auto;">
          {external ? 'Leggi su Instagram' : 'Approfondisci'} <ArrowIcon size={14} />
        </span>
      )
    }
  </div>
</Tag>
