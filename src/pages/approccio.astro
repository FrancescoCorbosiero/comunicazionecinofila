---
import Base from '../layouts/Base.astro';
import LeafIcon from '../components/LeafIcon.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import CoverImage from '../components/CoverImage.astro';
import andrea1 from '../assets/andrea-1.jpg';
import { LANDING_MODE } from '../config';

if (LANDING_MODE) return Astro.redirect('/');
---
<Base
  active="approccio"
  ogType="article"
  title="Il mio approccio — Andrea Bellettati · Comportamento & Nutrizione"
  description="Non parto dal prodotto, parto dall'animale: osservazione del soggetto, letteratura scientifica e contesto reale della famiglia. Il metodo dietro ogni consulenza."
  ogTitle="Il mio approccio — Andrea Bellettati"
  ogDescription="Non parto dal prodotto. Parto dall'animale. Alimentazione, comportamento e stile di vita nello stesso equilibrio."
  ogImage="/assets/andrea-1.jpg"
>
  <!-- PAGE HERO -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split-body" data-reveal>
          <span class="eyebrow kicker-rule">Il mio approccio</span>
          <h1 class="display-lg">
            Non parto<br />dal prodotto.<br /><span style="color:var(--peach-deep);"
              >Parto<br />dall'animale.</span
            >
          </h1>
          <p class="lead">
            Alimentazione, comportamento e stile di vita fanno parte dello stesso equilibrio. Il mio
            lavoro è osservare il soggetto nella sua globalità e costruire un percorso sostenibile
            per lui e per la sua famiglia.
          </p>
          <a class="btn btn-lg" href="/consulenza-gratuita">
            Richiedi la tua consulenza gratuita <ArrowIcon size={16} />
          </a>
        </div>
        <div class="split-media parallax-cover" data-reveal data-delay="1" style="aspect-ratio:4/5;">
          <CoverImage
            src={andrea1}
            alt="Andrea Bellettati seduto su una roccia con il suo bassotto, lungo un fiume di montagna"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFESTO / METODO -->
  <section class="section bg-deep paper-bg-deep">
    <div class="container">
      <div class="head-block" data-reveal>
        <span class="eyebrow kicker-rule">Il metodo</span>
        <h2 class="display-lg">Tre principi<br />che non negozio.</h2>
      </div>
      <div class="principi" data-reveal data-delay="1">
        <div class="principio">
          <span class="pno">01</span>
          <h3>Cibo e comportamento<br />sono la stessa storia</h3>
          <p>
            Un cane irrequieto, un gatto che si gratta, una digestione difficile: spesso la risposta
            è nella ciotola tanto quanto nelle abitudini. Li guardo insieme, mai separati.
          </p>
        </div>
        <div class="principio">
          <span class="pno">02</span>
          <h3>La scienza prima<br />delle mode</h3>
          <p>
            Niente slogan, niente “grain free” perché fa tendenza. Parto dalla letteratura, leggo le
            etichette riga per riga e spiego il perché di ogni scelta.
          </p>
        </div>
        <div class="principio">
          <span class="pno">03</span>
          <h3>Il piano deve entrare<br />nella vita vera</h3>
          <p>
            La dieta perfetta sulla carta non serve a niente se la famiglia non riesce a seguirla.
            Costruisco qualcosa di sostenibile, per l'animale e per chi se ne prende cura.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COME LAVORO -->
  <section class="section">
    <div class="container container-narrow">
      <div class="head-block" data-reveal>
        <span class="eyebrow kicker-rule">Come lavoro</span>
        <h2 class="display-lg">Tre fonti,<br />una direzione.</h2>
      </div>
      <div data-reveal data-delay="1">
        <p class="lead">
          Lavoro sull'equilibrio interno dell'animale mettendo insieme tre cose: ciò che la
          letteratura scientifica dice, ciò che osservo nel singolo soggetto, e il contesto reale
          della famiglia. Una dieta perfetta sulla carta non serve a nulla se non entra nella vita
          di tutti i giorni.
        </p>
        <p>
          E il percorso non si chiude con la consulenza: seguo personalmente ogni caso nel tempo, e
          dietro ogni scelta c'è il confronto con TeamNutrizione, il Team di professionisti con cui
          condivido un metodo di lavoro comune.
        </p>
      </div>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="section bg-sage paper-bg" style="background-color:var(--sage);">
    <div class="container">
      <div class="pullquote" data-reveal>
        <span class="section-mark" aria-hidden="true">
          <LeafIcon size={38} stroke="var(--cream-ink)" />
        </span>
        <q>
          Se l'alimentazione è sbagliata la medicina è inutile; se l'alimentazione è corretta la
          medicina non è necessaria.
        </q>
        <cite>Proverbio ayurvedico · il cuore del mio lavoro</cite>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight bg-deep paper-bg-deep">
    <div class="container container-narrow">
      <div class="cta-band">
        <h2 class="display-md">Raccontami il tuo animale.</h2>
        <p class="lead">Il primo passo è gratuito e senza impegno.</p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/consulenza-gratuita">Richiedi la tua consulenza gratuita</a>
          <a class="btn btn-ghost-cream btn-lg" href="/chi-sono">Conosci la mia storia</a>
        </div>
      </div>
    </div>
  </section>
</Base>
