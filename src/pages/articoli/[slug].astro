---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { SITE } from '../../config';
import { longDate } from '../../lib/dates';
import '../../styles/content.css';

export const getStaticPaths = (async () => {
  const all = await getCollection('articoli');
  // Pagine on-site solo per gli articoli pubblicati senza link esterno.
  return all
    .filter((a) => a.data.status === 'published' && !a.data.externalUrl)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

// Tempo di lettura (~200 parole/min) e indice dai titoli di secondo livello.
const minutes = Math.max(1, Math.round((entry.body ?? '').trim().split(/\s+/).length / 200));
const toc = headings.filter((h) => h.depth === 2);

// Condivisione: WhatsApp e copia link.
const pageUrl = new URL(`/articoli/${entry.id}/`, SITE).href;
const shareWa = `https://wa.me/?text=${encodeURIComponent(`${d.title} — ${pageUrl}`)}`;

// Articoli correlati: stessa categoria; se non bastano, i più recenti.
const all = await getCollection('articoli');
const onSite = all.filter(
  (a) => a.id !== entry.id && a.data.status === 'published' && !a.data.externalUrl
);
const sameCat = onSite.filter((a) => a.data.category === d.category);
const others = onSite.filter((a) => a.data.category !== d.category);
const related = [...sameCat, ...others]
  .sort((a, b) => (a.data.category === d.category ? -1 : 0) - (b.data.category === d.category ? -1 : 0))
  .slice(0, 3);

const articleLd = {
  '@type': 'Article',
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date.toISOString(),
  ...(d.cover ? { image: new URL(d.cover, SITE).href } : {}),
  author: { '@id': `${SITE}/#andrea` },
  mainEntityOfPage: new URL(`/articoli/${entry.id}`, SITE).href,
};

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/articoli' },
  { name: d.title, url: `/articoli/${entry.id}` },
];
---
<Base
  active="articoli"
  ogType="article"
  title={`${d.title} — Andrea Bellettati`}
  description={d.excerpt}
  ogTitle={d.title}
  ogDescription={d.excerpt}
  ogImage={d.cover ?? '/assets/articolo-antistaminico.jpg'}
  ogImageAlt={d.coverAlt ?? d.title}
  breadcrumbs={crumbs}
  jsonLd={articleLd}
>
  <!-- Avanzamento di lettura (solo qui: è una pagina da leggere) -->
  <div class="read-progress" aria-hidden="true"><span data-progress></span></div>

  <article class="section-tight">
    <div class="container container-narrow">
      <a class="text-link" href="/articoli">Torna al blog</a>
      <div class="head-block" data-reveal style="margin-top:18px; margin-bottom:28px;">
        <div class="card-meta">
          {d.category} · <span>{longDate(d.date)}</span> · <span>{minutes} min di lettura</span>
        </div>
        <h1 class="display-lg" transition:name={`art-${entry.id}`}>{d.title}</h1>
        <p class="lead">{d.excerpt}</p>
      </div>
      {
        d.cover && (
          <div
            class="card-media parallax-cover"
            style="aspect-ratio:16/10; border-radius:var(--r-3); margin-bottom:36px;"
            data-reveal
          >
            <img src={d.cover} alt={d.coverAlt ?? d.title} loading="eager" decoding="async" data-parallax data-parallax-cover />
          </div>
        )
      }
      {
        toc.length >= 3 && (
          <nav class="toc" data-reveal aria-label="Indice dell'articolo">
            <span class="toc-title">In questo articolo</span>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose" data-reveal>
        <Content />
      </div>

      <!-- CONDIVISIONE -->
      <div class="share-row" data-reveal>
        <span class="share-label">Ti è stato utile? Condividilo:</span>
        <a class="btn btn-sm" href={shareWa} target="_blank" rel="noopener">
          WhatsApp <WhatsAppIcon size={15} />
        </a>
        <button class="btn btn-ghost btn-sm" type="button" data-copy-url>Copia link</button>
      </div>
    </div>
  </article>

  <!-- CORRELATI -->
  {
    related.length > 0 && (
      <section class="section-tight">
        <div class="container">
          <div class="section-head-row" data-reveal>
            <div class="head-block" style="margin-bottom:0;">
              <span class="eyebrow kicker-rule">Continua a leggere</span>
              <h2 class="display-md">Potrebbero interessarti.</h2>
            </div>
            <a class="btn btn-ghost" href="/articoli">
              Tutti gli articoli <ArrowIcon size={15} />
            </a>
          </div>
          <div class="card-grid cols-3 stagger" data-reveal data-delay="1">
            {related.map((r) => (
              <ArticleCard entry={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="section-tight bg-sage paper-bg" style="background-color:var(--sage);">
    <div class="container container-narrow">
      <div class="cta-band">
        <h2 class="display-md">Hai una domanda<br />sul tuo animale?</h2>
        <p class="lead">Il primo confronto è gratuito e senza impegno.</p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/consulenza-gratuita">Consulenza gratuita <ArrowIcon size={16} /></a>
        </div>
      </div>
    </div>
  </section>
</Base>
