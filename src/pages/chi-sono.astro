---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Sticker from '../components/Sticker.astro';
import { IG_HANDLE, IG_URL, SITE_TAGLINE, STATS, formatNumber } from '../config';
import { assetImage } from '../lib/images';
import chiSonoPhoto from '../assets/chi-sono.jpg';
import consulenzaPhoto from '../assets/consulenza.jpg';
import heroPhoto from '../assets/hero.jpg';
import stkBassotto from '../assets/stickers/bassotto.webp';

// Il ritratto dell'hero: src/assets/ritratto.jpg se c'è (una foto più
// "professionale", vedi public/assets/README.md), altrimenti chi-sono.jpg.
const portrait = assetImage('ritratto') ?? chiSonoPhoto;

// Le polaroid del ventaglio (data-fan): l'ultima sta in cima alla pila.
const polaroid = [
  { src: consulenzaPhoto, alt: 'Il segugio e la bassotta di Andrea con i maglioni a quadri, sul letto', caption: 'maglioni a quadri' },
  { src: heroPhoto, alt: 'Andrea Bellettati seduto su una roccia con la sua bassotta, lungo un fiume di montagna', caption: 'pausa al fiume' },
  { src: chiSonoPhoto, alt: 'Andrea Bellettati guancia a guancia con il suo segugio, in inverno', caption: 'guancia a guancia' },
];

// Il percorso: un sentiero di impronte unisce le tappe (data-trail).
// NOTE: date/tappe da confermare con Andrea — struttura pronta, testi modificabili.
const tappe = [
  {
    when: "L'inizio",
    title: 'Dalla convivenza allo studio',
    body: 'La curiosità per ciò che metto nella ciotola del mio cane diventa studio serio: etichette, ingredienti, letteratura scientifica. Capisco quanto poco se ne parli davvero.',
    tone: 'paper',
  },
  {
    when: '2021',
    title: 'Entro in un team multidisciplinare',
    body: 'Mi unisco a un gruppo di professionisti nato per portare consapevolezza su un argomento troppo spesso sottovalutato: il Team che oggi chiamiamo TeamNutrizione. Formazione continua, confronto e metodo condiviso.',
    tone: 'mist',
  },
  {
    when: 'Oggi',
    title: 'Consulenze e divulgazione',
    body: "Consulenze 1:1 per famiglie, webinar e contenuti come “Etichette a 4 Zampe” e l'antistaminico naturale. Sempre con lo stesso obiettivo: scelte consapevoli.",
    tone: 'blush',
  },
  {
    when: 'Con te',
    title: 'Il prossimo passo',
    body: 'Una consulenza gratuita di 45 minuti per analizzare alimentazione e comportamento del tuo animale, e un piano di lavoro firmato su misura.',
    tone: 'peach',
    link: { href: '/consulenza-gratuita', label: 'Richiedi la tua consulenza gratuita' },
  },
];

const PAW_D = [
  { cx: 12, cy: 15, rx: 4.3, ry: 5.8 },
  { cx: 21, cy: 10, rx: 4.3, ry: 6 },
  { cx: 30, cy: 11, rx: 4.3, ry: 6 },
  { cx: 38.5, cy: 16, rx: 4.3, ry: 5.6 },
  { cx: 25, cy: 29, rx: 9.5, ry: 8 },
];

// La scheda Instagram: avatar, bio e un'anteprima di post che porta al profilo.
const igHandle = IG_HANDLE.replace(/^@/, '');
---
<Base
  active="chi-sono"
  ogType="article"
  title="Chi sono — Andrea Bellettati · La mia storia"
  description="Mi chiamo Andrea Bellettati, consulente in comportamento e nutrizione per cani e gatti. Vivo con una bassotta: la teoria la verifico ogni giorno, a casa. La mia storia e il mio percorso."
  ogTitle="Chi sono — Andrea Bellettati"
  ogDescription="Vivo con una bassotta: la teoria la verifico ogni giorno, a casa. La mia storia, dal primo sacco di crocchette a un metodo condiviso."
  ogImage="/assets/consulenza.jpg"
  ogImageAlt="Il segugio e la bassotta di Andrea con i maglioni a quadri, sul letto"
  ogImageWidth={1440}
  ogImageHeight={1440}
>
  <!-- HERO — un biglietto da visita, non un cartellino: nome e ruolo in
       chiaro, la foto incorniciata ad arco, i numeri che contano, il sigillo
       del Team e la firma a mano (la stessa che chiude ogni piano di lavoro).
       Autorevole, ma con il calore di una firma vera. -->
  <section class="cs-hero" aria-labelledby="cs-title">
    <div class="container cs-hero-grid">
      <div class="cs-hero-copy">
        <span class="eyebrow kicker-rule" data-intro style="--intro-d:0.05s;">Chi sono</span>
        <h1 class="cs-title intro-lines" id="cs-title">
          <span class="line"><span>Andrea</span></span>
          <span class="line"><span>Bellettati</span></span>
        </h1>
        <p class="cs-role" data-intro style="--intro-d:0.5s;">
          Consulente in comportamento e nutrizione per cani e gatti
        </p>
        <p class="lead" data-intro style="--intro-d:0.65s;">
          Studio da anni la relazione tra alimentazione e comportamento: non si può parlare di
          benessere animale senza tenerli insieme. E lavoro al fianco del tuo veterinario, mai al suo
          posto.
        </p>
        <ul class="cs-creds" data-intro style="--intro-d:0.8s;">
          <li><b>{STATS.teamSince}</b><span>nel Team di professionisti</span></li>
          <li><b>{formatNumber(STATS.posts)}</b><span>contenuti divulgativi</span></li>
          <li><b>{formatNumber(STATS.followers)}</b><span>persone mi seguono</span></li>
        </ul>
        <div class="cs-ctas" data-intro style="--intro-d:0.95s;">
          <a class="btn btn-lg" href="/consulenza-gratuita">
            Richiedi la tua consulenza gratuita <ArrowIcon size={16} />
          </a>
          <a class="btn btn-ghost-cream btn-lg" href="/approccio">Il mio approccio</a>
        </div>
      </div>
      <!-- Parallax (data-speed) sul contenitore: la cornice ha la sua intro
           CSS su scale e GSAP non deve leggerla a metà. -->
      <figure class="cs-portrait" data-speed="0.06">
        <div class="cs-portrait-frame">
          <Image
            src={portrait}
            alt="Andrea Bellettati, consulente in comportamento e nutrizione per cani e gatti"
            widths={[480, 720, 960].filter((w) => w <= portrait.width)}
            sizes="(min-width: 900px) 450px, 84vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <span class="cs-seal" aria-hidden="true">
          <svg viewBox="0 0 200 200" data-spin>
            <defs><path id="cs-seal-path" d="M100 100m-76 0a76 76 0 1 1 152 0a76 76 0 1 1-152 0"></path></defs>
            <text><textPath href="#cs-seal-path" textLength="468" lengthAdjust="spacing">TeamNutrizione · metodo condiviso ·</textPath></text>
          </svg>
          <span class="cs-seal-core"><small>dal</small><b>{STATS.teamSince}</b></span>
        </span>
        <figcaption class="cs-sign">Andrea Bellettati</figcaption>
      </figure>
    </div>
  </section>

  <!-- BIO — le polaroid partono impilate e si aprono a ventaglio (data-fan) -->
  <section class="section cs-bio" aria-labelledby="bio-title">
    <div class="container">
      <div class="cs-bio-head">
        <div class="head-block">
          <span class="eyebrow kicker-rule">Vivo con una bassotta</span>
          <h2 class="display-lg" id="bio-title">La teoria la verifico ogni giorno, <span class="script">a casa.</span></h2>
        </div>
        <div class="cs-bio-text" data-reveal>
          <p>
            Convivo con una bassotta: ogni cosa che studio passa prima dalla nostra quotidianità. Le
            passeggiate, i pasti, le piccole intolleranze, gli inverni in montagna. È lì che la
            nutrizione smette di essere una tabella e diventa cura concreta.
          </p>
          <p>
            Questo è anche il modo in cui lavoro con te: con la pazienza e l'onestà di chi sa che
            dall'altra parte c'è un compagno di vita, non un “caso”.
          </p>
        </div>
      </div>
      <div class="cs-fan" data-fan>
        {
          polaroid.map((p, i) => (
            <figure class={`cs-pol cs-pol--${i + 1}`} data-fan-item>
              <Image src={p.src} alt={p.alt} widths={[360, 720]} sizes="(min-width: 900px) 340px, 50vw" loading="lazy" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))
        }
        <Sticker src={stkBassotto} width={128} rotate={-8} class="cs-fan-dog" data-float />
      </div>
      <blockquote class="cs-note" data-reveal>
        <p>
          «Alimentare correttamente il proprio amico a quattro zampe è, insieme alla sua educazione,
          la più grande forma di amore.»
        </p>
      </blockquote>
    </div>
  </section>

  <!-- IL PERCORSO — le impronte percorrono il sentiero al passo con lo
       scroll e accendono le tappe (data-trail). -->
  <section class="section bg-deep cs-path" aria-labelledby="path-title">
    <div class="container">
      <div class="head-block">
        <span class="eyebrow kicker-rule">Il percorso</span>
        <h2 class="display-lg" id="path-title">Da una passione <span class="script">a un metodo.</span></h2>
      </div>
      <div class="trail" data-trail>
        <svg class="trail-svg" data-trail-svg aria-hidden="true"><path data-trail-path></path></svg>
        <div class="trail-paws" data-trail-paws aria-hidden="true"></div>
        <ol class="trail-steps">
          {
            tappe.map((t, i) => (
              <li class="trail-step" data-trail-step>
                <span class="trail-dot" data-trail-stop aria-hidden="true">
                  {i === tappe.length - 1 ? (
                    <svg viewBox="0 0 24 22" fill="currentColor">
                      <path d="M12 21.5S1.5 15 1.5 7.6C1.5 4 4.2 1.5 7.3 1.5c2 0 3.7 1 4.7 2.6 1-1.6 2.7-2.6 4.7-2.6 3.1 0 5.8 2.5 5.8 6.1C22.5 15 12 21.5 12 21.5Z" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 50 44" fill="currentColor">
                      {PAW_D.map((e) => (
                        <ellipse cx={e.cx} cy={e.cy} rx={e.rx} ry={e.ry} />
                      ))}
                    </svg>
                  )}
                </span>
                <div class={`trail-card tone-${t.tone}`}>
                  <span class="trail-when">{t.when}</span>
                  <h3>{t.title}</h3>
                  <p>{t.body}</p>
                  {t.link && (
                    <a class="text-link" href={t.link.href}>
                      {t.link.label} <ArrowIcon size={14} />
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- CTA — foglio pesca e la scheda del profilo Instagram -->
  <section class="cs-cta" aria-labelledby="cs-cta-title">
    <div class="container cs-cta-grid">
      <div class="cs-cta-copy">
        <span class="eyebrow">Consulenza gratuita · 45 minuti</span>
        <h2 class="cs-cta-title" id="cs-cta-title" data-split="pop">
          Raccontami il <span class="script">tuo animale.</span>
        </h2>
        <p class="lead">
          Il primo passo è gratuito e senza impegno. Nel frattempo, ci vediamo su Instagram.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg btn-dark" href="/consulenza-gratuita">Richiedi la tua consulenza gratuita</a>
          <a class="btn btn-ghost btn-lg" href="/lavora-con-noi">Lavora con noi</a>
        </div>
      </div>
      <aside class="ig-card" data-tilt aria-label="Il profilo Instagram di Andrea">
        <span class="cs-cta-note" aria-hidden="true">seguimi!</span>
        <div class="ig-head">
          <span class="ig-avatar"><img src="/assets/logo.jpg" alt="" width="52" height="52" loading="lazy" decoding="async" /></span>
          <span class="ig-id"><b>{igHandle}</b><small>Andrea Bellettati</small></span>
          <a class="btn btn-sm ig-follow" href={IG_URL} target="_blank" rel="noopener">Segui</a>
        </div>
        <p class="ig-bio">{SITE_TAGLINE}</p>
        <a class="ig-grid" href={IG_URL} target="_blank" rel="noopener" aria-label={`Apri il profilo Instagram ${IG_HANDLE}`}>
          <img src="/assets/articolo-antistaminico-naturale-per-cani.jpg" alt="" width="128" height="128" loading="lazy" decoding="async" />
          <Image src={heroPhoto} alt="" widths={[160, 320]} sizes="128px" loading="lazy" />
          <Image src={consulenzaPhoto} alt="" widths={[160, 320]} sizes="128px" loading="lazy" />
        </a>
        <div class="ig-foot">
          <button type="button" class="ig-like" data-pet aria-label="Mi piace">
            <svg viewBox="0 0 24 22" fill="currentColor" aria-hidden="true">
              <path d="M12 21.5S1.5 15 1.5 7.6C1.5 4 4.2 1.5 7.3 1.5c2 0 3.7 1 4.7 2.6 1-1.6 2.7-2.6 4.7-2.6 3.1 0 5.8 2.5 5.8 6.1C22.5 15 12 21.5 12 21.5Z"></path>
            </svg>
          </button>
          <span>Alimentazione, comportamento e vita quotidiana con cani e gatti.</span>
        </div>
      </aside>
    </div>
  </section>
</Base>
