---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Sticker from '../components/Sticker.astro';
import Ticker from '../components/Ticker.astro';
import coverPhoto from '../assets/lavora-con-noi.jpg';
import stkAndreaSegugio from '../assets/stickers/andrea-segugio.webp';
import stkBassotto from '../assets/stickers/bassotto.webp';

// La lente sul branco (motion.ts, data-lens) ingrandisce la stessa foto:
// le serve una versione a piena risoluzione.
const lensImage = await getImage({ src: coverPhoto, width: 1778, format: 'webp', quality: 72 });
const coverAlt =
  'TeamNutrizione — Al tuo fianco per il benessere del tuo pet: cani e gatti di tante razze in fila';

// "A chi è rivolto": ogni profilo è uno sticker cliccabile che preseleziona
// l'ambito nel modulo di candidatura (site.ts, initProfileWall).
const profili = [
  { label: 'Educatori e istruttori cinofili', ambito: 'Educazione cinofila' },
  { label: 'Naturopati e operatori del benessere animale', ambito: 'Naturopatia' },
  { label: 'Toelettatori', ambito: 'Toelettatura' },
  { label: 'Allevatori', ambito: 'Allevamento' },
  { label: 'Pet sitter e dog sitter', ambito: 'Pet sitting' },
  { label: 'Professionisti del settore pet', ambito: 'Altro' },
  { label: 'Appassionati di alimentazione e benessere naturale', ambito: 'Altro' },
  { label: 'Chi vuole costruire una nuova attività nel mondo animale', ambito: 'Altro' },
];
const wallTones = ['peach', 'paper', 'sage', 'ink'];
const wallTilt = [-4, 3, -2, 5, -3, 2, -5, 3];

const ambiti = [
  'Educazione cinofila',
  'Toelettatura',
  'Allevamento',
  'Pet sitting',
  'Naturopatia',
  'Veterinaria',
  'Altro',
];

const tempi = ['Qualche ora a settimana', 'Part-time', 'Attività principale', 'Non lo so ancora'];

// Nastro sotto l'hero: le stesse persone di "A chi è rivolto", in breve.
const nastro = [
  'Educatori cinofili',
  'Naturopati',
  'Toelettatori',
  'Allevatori',
  'Pet sitter',
  'Dog sitter',
  'Professionisti del pet',
  'Appassionati di benessere naturale',
];

// I tre principi: card che si impilano con lo scroll.
const principi = [
  {
    n: '01',
    title: "Si parte dall'ascolto",
    body: "Il lavoro non parte da un listino: parte dall'ascolto delle persone e dei loro animali. Prima capire, poi proporre.",
    tone: 'peach',
    icon: 'ear',
  },
  {
    n: '02',
    title: 'Analisi, non catalogo',
    body: "Analizziamo abitudini, stile di vita ed esigenze reali di ogni soggetto. È da lì che nasce ogni proposta, mai dal prodotto.",
    tone: 'sage',
    icon: 'lens',
  },
  {
    n: '03',
    title: 'Supporto nel tempo',
    body: 'Consulenza, formazione e supporto continuo sono la base del metodo: il cliente non viene lasciato solo dopo la prima ciotola.',
    tone: 'ink',
    icon: 'loop',
  },
];
const icons: Record<string, string> = {
  ear: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M10 26c0-12 9-20 22-20s22 8 22 20c0 9-6 13-11 17-4 3-5 6-6 10-1 5-5 8-10 8"/><path d="M22 28c0-7 4-11 10-11s10 4 10 10c0 4-3 6-5 8"/><path d="M48 52l6 6M52 44l8 2"/></svg>',
  lens: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><circle cx="27" cy="27" r="17"/><path d="M40 40l16 16"/><path d="M19 27a8 8 0 0 1 8-8"/></svg>',
  loop: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M52 30a20 20 0 1 1-6-14"/><path d="M48 6v12H36"/><path d="M32 20v13l8 5"/></svg>',
};
---
<Base
  active="lavora"
  title="Lavora con noi — Andrea Bellettati · TeamNutrizione"
  description="Il benessere animale può diventare anche il tuo lavoro. TeamNutrizione: formazione, affiancamento e un modello di lavoro dichiarato con trasparenza. Raccontami chi sei."
  ogTitle="Lavora con noi — TeamNutrizione"
  ogDescription="Non una rete di venditori: un Team di persone e professionisti che vogliono sviluppare competenze nell'alimentazione e nel benessere animale."
  ogImage="/assets/og-lavora-con-noi.jpg"
  ogImageAlt={coverAlt}
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <!-- COVER: lo striscione TeamNutrizione. Si srotola all'arrivo (motion.css),
       con il mouse diventa una lente sul branco (motion.ts, data-lens). -->
  <section class="tn-cover">
    <div class="tn-cover-frame" data-lens={lensImage.src} data-hero-away="12" data-hero-fade="0.85">
      <Image
        src={coverPhoto}
        alt={coverAlt}
        widths={[640, 1024, 1440, 1778]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={78}
        class="tn-cover-img"
      />
      <span class="lens-hint" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2.2"></circle>
          <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
        </svg>
        Passa sopra: conosci il branco
      </span>
    </div>
  </section>

  <!-- HERO -->
  <section class="l-hero" data-paw-trail data-sticky-from>
    <div class="container l-hero-inner">
      <span class="eyebrow kicker-rule" data-intro style="--intro-d:0.3s;">Lavora con noi · TeamNutrizione</span>
      <h1 class="l-title intro-lines" style="--intro-base:0.45s;">
        <span class="line"><span>Il benessere animale</span></span>
        <span class="line"><span>può diventare anche</span></span>
        <span class="line"><span>il tuo <span class="l-title-hl">lavoro.</span></span></span>
      </h1>
      <div class="l-hero-row" data-intro style="--intro-d:0.95s;">
        <p class="lead">
          Non stiamo costruendo una rete di venditori. Stiamo creando un Team di persone e
          professionisti che vogliono sviluppare competenze nell'alimentazione e nel benessere
          animale.
        </p>
        <a class="btn btn-lg" href="#candidatura">Raccontami chi sei <ArrowIcon size={16} /></a>
      </div>
    </div>
    <Sticker src={stkAndreaSegugio} width={250} rotate={-5} eager class="l-hero-andrea" data-float />
  </section>

  <Ticker items={nastro} tone="peach" tilt={-1.6} />

  <!-- COME LAVORIAMO: la parola sbagliata viene barrata a mano -->
  <section class="l-strike" data-strike aria-labelledby="strike-title">
    <div class="container">
      <span class="eyebrow kicker-rule">Come lavoriamo</span>
      <h2 class="l-strike-title" id="strike-title">
        <span class="l-strike-line">Stiamo creando</span>
        <span class="l-strike-old">
          <del>una rete di venditori</del>
          <svg class="l-strike-svg" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
            <path
              data-strike-path
              d="M10 74C90 44 170 92 250 62s170-40 250-6c32 13 60 10 88 0M22 98c120-40 260-6 360-32 70-18 140-30 200-4"
              fill="none"
              stroke="currentColor"
              stroke-width="9"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <ins class="l-strike-new">un Team.</ins>
      </h2>
      <p class="lead l-strike-sub">
        Non cerchiamo semplici venditori: cerchiamo persone e professionisti che vogliono
        sviluppare competenze nell'alimentazione e nel benessere animale.
      </p>
    </div>
  </section>

  <!-- I PRINCIPI: card che si impilano -->
  <section class="section l-principles">
    <div class="container">
      <div class="head-block">
        <span class="eyebrow kicker-rule">Il metodo</span>
        <h2 class="display-lg">Prima capire, <span class="script">poi proporre.</span></h2>
      </div>
      <div class="stack" data-stack>
        {
          principi.map((p, i) => (
            <article class={`stack-card tone-${p.tone}`} data-stack-card style={`--i:${i}`}>
              <span class="sc-n" aria-hidden="true">{p.n}</span>
              <div class="sc-body">
                <span class="sc-icon" aria-hidden="true" set:html={icons[p.icon]} />
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- A CHI È RIVOLTO: muro di sticker -->
  <section class="section l-who">
    <div class="container">
      <div class="l-who-head">
        <div class="head-block">
          <span class="eyebrow kicker-rule">A chi è rivolto</span>
          <h2 class="display-lg">Persone diverse, <span class="script">stessa serietà.</span></h2>
        </div>
        <p class="lead">
          Non serve sapere già tutto: servono ascolto, serietà, sensibilità e una reale volontà di
          formarsi. <strong>Ti riconosci? Tocca il tuo sticker.</strong>
        </p>
      </div>
      <ul class="sticker-wall" data-sticker-wall data-profile-wall>
        {
          profili.map((p, i) => (
            <li data-wall-item style={`--tilt:${wallTilt[i]}deg`}>
              <button
                type="button"
                class={`pstk tone-${wallTones[i % wallTones.length]}`}
                data-ambito={p.ambito}
                aria-pressed="false"
              >
                {p.label}
              </button>
            </li>
          ))
        }
      </ul>
      <p class="wall-hint" data-wall-hint hidden>
        <span data-wall-text></span>
        <a class="btn btn-sm" href="#candidatura">Vai alla candidatura <ArrowIcon size={14} /></a>
      </p>
      <Sticker src={stkBassotto} width={120} rotate={8} class="l-who-dog" data-float />
    </div>
  </section>

  <!-- FLESSIBILITÀ + FORMAZIONE -->
  <section class="section l-flex">
    <div class="container l-flex-grid">
      <article class="flex-card tone-paper" data-tilt data-reveal>
        <span class="flex-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="12" width="34" height="24" rx="3"></rect><path d="M4 40h42"></path><path d="M44 26l10-8 8 7v21H44z"></path><path d="M50 46v-8h6v8"></path></svg>
        </span>
        <h3>Attività flessibile, online e offline</h3>
        <p>
          Sviluppi l'attività sui tuoi tempi e sui tuoi obiettivi: può affiancare il lavoro che fai
          già oppure crescere fino a diventare la tua attività principale, di persona o a distanza.
        </p>
      </article>
      <article class="flex-card tone-sage" data-tilt data-reveal>
        <span class="flex-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 24l28-12 28 12-28 12z"></path><path d="M16 30v14c8 6 24 6 32 0V30"></path><path d="M60 24v16"></path></svg>
        </span>
        <h3>Formazione e affiancamento</h3>
        <p>
          Hai accesso a formazione, materiali e confronto costante con il Team. Ti accompagniamo dal
          primo contatto fino alla costruzione della tua rete.
        </p>
      </article>
    </div>
  </section>

  <!-- IL MODELLO, CON TRASPARENZA: un foglio d'appunti con l'evidenziatore -->
  <section class="section l-note-sec">
    <div class="container container-narrow">
      <article class="l-note" data-reveal>
        <span class="eyebrow kicker-rule">Trasparenza, prima di tutto</span>
        <h2 class="display-md">Il nostro modello di lavoro.</h2>
        <p>
          TeamNutrizione lavora con un modello di <mark class="hl" data-hl>Multi Level Marketing</mark>
          applicato al benessere animale — e preferiamo dirlo subito, con trasparenza. È un'attività
          indipendente, costruita sulla consulenza e sulla relazione con il cliente, con la
          possibilità di creare e formare un proprio Team.
        </p>
        <p>
          La crescita è legata al lavoro reale: <mark class="hl" data-hl>nessuna promessa di guadagni facili</mark>.
          Quello che offriamo è un metodo, formazione, esperienza e affiancamento.
        </p>
        <div class="l-note-foot">
          <span class="l-note-sign">— Andrea</span>
          <a class="btn" href="#candidatura">Raccontami chi sei <ArrowIcon size={15} /></a>
        </div>
      </article>
    </div>
  </section>

  <!-- FORM CANDIDATURA -->
  <section class="section l-apply" id="candidatura" data-sticky-until>
    <div class="container l-apply-grid">
      <div class="l-apply-copy">
        <span class="eyebrow kicker-rule">Candidatura</span>
        <h2 class="display-lg">Raccontami <span class="script">chi sei.</span></h2>
        <p class="lead">
          Tre passaggi, un paio di minuti. Ti ricontatto personalmente per un primo confronto senza
          impegno: nessun automatismo, nessuna lista d'attesa.
        </p>
        <ul class="svc-includes">
          <li>Primo confronto conoscitivo, senza impegno</li>
          <li>Formazione e affiancamento dal primo giorno</li>
          <li>Modello di lavoro dichiarato con trasparenza</li>
        </ul>
      </div>
      <div class="form-card l-apply-card">
        <!-- Netlify Forms: il bot di deploy registra il form dall'HTML statico;
             l'invio reale avviene via fetch in site.ts (initWorkForm).
             Le candidature arrivano nella dashboard Netlify (+ notifiche email). -->
        <form
          data-workform
          novalidate
          name="candidatura-team"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="candidatura-team" />
          <p class="hp-field" aria-hidden="true">
            <label>Non compilare questo campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="steps-head">
            <span class="step-dot"></span>
            <span class="step-dot"></span>
            <span class="step-dot"></span>
          </div>

          <!-- STEP 1 — chi sei -->
          <div class="step-panel active">
            <span class="step-label">Passo 1 di 3</span>
            <h3 class="step-q">Chi sei?</h3>
            <div class="field">
              <label for="w-nome">Nome e cognome</label>
              <input id="w-nome" name="nome" type="text" placeholder="Es. Marco Rossi" required />
              <span class="field-error">Scrivi il tuo nome per continuare.</span>
            </div>
            <div class="field">
              <label for="w-email">Email</label>
              <input id="w-email" name="email" type="email" placeholder="nome@esempio.it" required />
              <span class="field-error">Serve un'email valida per ricontattarti.</span>
            </div>
            <div class="field">
              <label for="w-tel">Telefono</label>
              <input id="w-tel" name="telefono" type="tel" placeholder="+39 3xx xxx xxxx" required />
              <span class="field-error">Serve un recapito telefonico.</span>
            </div>
            <div class="step-nav">
              <span></span>
              <button type="button" class="btn" data-next>Continua <ArrowIcon size={15} /></button>
            </div>
          </div>

          <!-- STEP 2 — il tuo percorso -->
          <div class="step-panel">
            <span class="step-label">Passo 2 di 3</span>
            <h3 class="step-q">Il tuo percorso.</h3>
            <div class="field">
              <label for="w-occupazione">Di cosa ti occupi attualmente?</label>
              <input
                id="w-occupazione"
                name="occupazione"
                type="text"
                placeholder="Es. educatrice cinofila, impiegato, studentessa…"
                required
              />
              <span class="field-error">Una riga basta: mi aiuta a capire da dove parti.</span>
            </div>
            <div class="field">
              <label for="w-settore">Lavori già nel settore animale?</label>
              <select id="w-settore" name="settore_animale" required>
                <option value="" disabled selected>Seleziona…</option>
                <option value="Sì">Sì</option>
                <option value="No">No</option>
              </select>
              <span class="field-error">Seleziona una risposta.</span>
            </div>
            <div class="field">
              <label for="w-ambito">Qual è il tuo ambito?</label>
              <select id="w-ambito" name="ambito" required>
                <option value="" disabled selected>Seleziona…</option>
                {ambiti.map((a) => <option value={a}>{a}</option>)}
              </select>
              <span class="field-error">Seleziona l'ambito più vicino a te.</span>
            </div>
            <div class="step-nav">
              <button type="button" class="btn btn-ghost" data-prev>Indietro</button>
              <button type="button" class="btn" data-next>Continua <ArrowIcon size={15} /></button>
            </div>
          </div>

          <!-- STEP 3 — il progetto -->
          <div class="step-panel">
            <span class="step-label">Passo 3 di 3</span>
            <h3 class="step-q">Il progetto.</h3>
            <div class="field">
              <label for="w-perche">Perché ti interessa questo progetto?</label>
              <textarea
                id="w-perche"
                name="perche"
                rows="3"
                placeholder="Due righe sincere valgono più di una lettera di presentazione."
                required></textarea>
              <span class="field-error">Raccontami in due righe cosa ti attira del progetto.</span>
            </div>
            <div class="field">
              <label for="w-tempo">Quanto tempo vorresti dedicare?</label>
              <select id="w-tempo" name="tempo" required>
                <option value="" disabled selected>Seleziona…</option>
                {tempi.map((t) => <option value={t}>{t}</option>)}
              </select>
              <span class="field-error">Seleziona una risposta.</span>
            </div>
            <div class="field">
              <label for="w-social">
                Instagram o sito professionale
                <span style="text-transform:none; letter-spacing:0; font-weight:400; color:var(--ink-mute);"
                  >(facoltativo)</span
                >
              </label>
              <input
                id="w-social"
                name="social"
                type="text"
                placeholder="@iltuoprofilo oppure www.iltuosito.it"
              />
            </div>
            <div class="step-nav">
              <button type="button" class="btn btn-ghost" data-prev>Indietro</button>
              <button type="submit" class="btn">Invia la candidatura <ArrowIcon size={15} /></button>
            </div>
            <p class="field-hint">
              Nessuna newsletter, nessuno spam: uso questi dati solo per ricontattarti.
            </p>
          </div>

          <!-- SUCCESS -->
          <div class="form-success" role="status" tabindex="-1">
            <span class="success-check">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12.5 10 17 19 7" stroke="var(--cream-ink)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <h3 class="display-md">Candidatura inviata.</h3>
            <p style="max-width:420px;">Grazie, ti ricontatto presto. — Andrea</p>
          </div>

          <!-- ERRORE DI RETE: la candidatura non si perde, si sposta sull'email -->
          <p class="form-error" role="alert" data-form-error>
            Non sono riuscito a inviare la candidatura (problema di rete?). Riprova tra poco
            oppure <a class="text-link" data-error-mail href="#">scrivimi via email</a>: il
            messaggio è già pronto con le tue risposte.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- CTA fissa: compare dopo l'hero, sparisce sulla candidatura -->
  <a class="sticky-cta" href="#candidatura" data-sticky-cta data-no-roll>
    <span class="sticky-cta-dot" aria-hidden="true"></span>
    Candidati: raccontami chi sei
    <ArrowIcon size={16} />
  </a>
</Base>
