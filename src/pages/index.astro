---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import heroPhoto from '../assets/hero.jpg';
import chiSonoPhoto from '../assets/chi-sono.jpg';
import consulenzaPhoto from '../assets/consulenza.jpg';
import { assetImage } from '../lib/images';
import { eventDay, eventMonthTime } from '../lib/dates';
import { IG_URL, STATS, WA_LINK, formatNumber, waLink } from '../config';

/* Home v5 — editoriale. Un compito solo: portare il proprietario alla
   consulenza gratuita e chi vuole lavorare nel Team al colloquio. I due
   flussi sono sempre in vista (hero, porte, header, barra fissa su
   telefono) e ogni altro percorso del sito è a un click dall'indice.
   Ordine: promessa → scegli il percorso → chi sono → l'approccio →
   come funziona → storie vere → prossimo incontro → dal blog → domande → CTA. */

// Blog: gli ultimi tre articoli con pagina di dettaglio, più il rimando all'indice.
const articoli = await getCollection('articoli');
const latestArticoli = articoli
  .filter((a) => a.data.status === 'published' && !a.data.externalUrl)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const nArticoli = articoli.filter((a) => a.data.status === 'published').length;

// Prossimo incontro: il primo evento in programma con una data futura;
// altrimenti il primo "in arrivo" o "su richiesta". Senza nulla, la sezione sparisce.
const eventi = await getCollection('eventi');
const now = Date.now();
const inProgramma = eventi
  .filter((e) => e.data.status === 'upcoming' && e.data.date && e.data.date.getTime() >= now)
  .sort((a, b) => a.data.date!.getTime() - b.data.date!.getTime());
const prossimo =
  inProgramma[0] ?? eventi.find((e) => e.data.status === 'coming-soon') ?? eventi.find((e) => e.data.status === 'on-request');
const prossimoHref = prossimo
  ? (prossimo.data.externalUrl ?? prossimo.data.internalUrl ?? `/eventi/${prossimo.id}`)
  : null;
const prossimoEsterno = Boolean(prossimo?.data.externalUrl);

// "Come funziona": i quattro passi, dal questionario al piano.
const passi = [
  {
    title: 'Compili il questionario',
    body: 'Mi racconti il tuo animale: due minuti, tre domande.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3.5" width="14" height="17" rx="2.5"/><path d="M9 3.5h6v3H9zM8.5 11h7M8.5 14.5h7M8.5 18h4"/></svg>',
  },
  {
    title: 'Ti richiamo',
    body: 'Al numero che mi lasci, per fissare la chiamata.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M5 4h3l1.5 4-2 1.5a11 11 0 005 5l1.5-2 4 1.5V18a2 2 0 01-2 2A14 14 0 014 6a2 2 0 011-2z"/></svg>',
  },
  {
    title: 'Parliamo 45 minuti',
    body: 'Alimentazione e comportamento, insieme.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h11a2 2 0 012 2v5a2 2 0 01-2 2H9l-4 3.5v-3.5H4a2 2 0 01-2-2v-5a2 2 0 012-2z"/><path d="M19 9.5h1a2 2 0 012 2V16a2 2 0 01-2 2h-1v3l-3.5-3H12"/></svg>',
  },
  {
    title: 'Ricevi il piano',
    body: 'Scritto, firmato e su misura per lui.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3.5H7a2 2 0 00-2 2v13a2 2 0 002 2h10a2 2 0 002-2v-10z"/><path d="M14 3.5v5h5M8.5 16.5c1.2-1.6 2.2-1.6 2.8 0s1.6 1.6 3-0.6c.6-.9 1.2-.9 1.7 0"/></svg>',
  },
];

// L'indice dei percorsi: tutto ciò che si può fare sul sito, a un click.
const ICON = {
  compass:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/></svg>',
  person:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"/></svg>',
  stories:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="14" rx="2.5"/><path d="m3.5 15 4.5-4.5 4 4 3-3 5.5 5.5"/><circle cx="16" cy="9" r="1.2"/></svg>',
  book:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 18V5.5M8 7h8M8 10.5h6"/></svg>',
  calendar:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>',
  bowl:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 11.5h17a8.5 8.5 0 0 1-17 0z"/><path d="M12 11.5V8M8.5 11.5l1-3M15.5 11.5l-1-3"/></svg>',
  chat:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4A2.5 2.5 0 0 1 4 13.5z"/></svg>',
};
const percorsi = [
  { href: '/approccio', icon: ICON.compass, title: 'Il mio approccio', text: 'Non parto dal prodotto, parto dall’animale.' },
  { href: '/chi-sono', icon: ICON.person, title: 'Chi sono', text: 'La mia storia, dal primo cane a un metodo condiviso.' },
  { href: '#storie', icon: ICON.stories, title: 'Storie vere', text: 'Prima e dopo, con tempi e punto di partenza.' },
  { href: '/articoli', icon: ICON.book, title: 'Blog', text: `${nArticoli} articoli su alimentazione e comportamento.` },
  { href: '/eventi', icon: ICON.calendar, title: 'Eventi e webinar', text: 'Gli incontri dal vivo e online.' },
  { href: '/servizi', icon: ICON.bowl, title: 'I servizi', text: 'Consulenze, percorsi e monitoraggio.' },
  { href: WA_LINK, icon: ICON.chat, title: 'Scrivimi su WhatsApp', text: 'Una domanda veloce, senza questionario.', wa: true },
];

// Storie vere: le foto arrivano per nome (src/assets/storia-*.jpg).
const zoePrima = assetImage('storia-zoe-prima');
const zoeDopo = assetImage('storia-zoe-dopo');
const pelleFoto = assetImage('storia-pelle');

// Le foto vere di Andrea (src/assets/home-*.jpg), con le vecchie come ripiego.
const heroPortrait = assetImage('home-hero') ?? chiSonoPhoto;
const heroDetail = assetImage('home-ciotola') ?? consulenzaPhoto;
const aboutPhoto = assetImage('home-chi-sono') ?? chiSonoPhoto;
const aboutSide = assetImage('home-approccio') ?? heroPhoto;
const approccioPhoto = heroPhoto;

// FAQ: le domande che arrivano prima di compilare il questionario.
const faqs = [
  {
    q: 'La consulenza è davvero gratuita?',
    a: 'Sì. Dura 45 minuti e alla fine ricevi un documento firmato con il piano di lavoro proposto. Decidi tu se e come proseguire: nessun impegno.',
  },
  {
    q: 'Sostituisce il veterinario?',
    a: 'No. Lavoro su alimentazione e comportamento, al fianco del tuo veterinario. Per sintomi, farmaci e diagnosi il riferimento resta sempre lui.',
  },
  {
    q: 'Vale anche per i gatti?',
    a: 'Sì, la consulenza è per cani e gatti, a ogni età.',
  },
  {
    q: 'Cosa succede dopo il questionario?',
    a: 'Ti ricontatto io al numero che hai indicato, per fissare la chiamata quando ti è più comodo.',
  },
  {
    q: 'Entrare nel Team ha un costo?',
    a: 'Al colloquio conoscitivo ricevi tutte le informazioni su attività, costi e guadagni, prima di decidere qualsiasi cosa.',
  },
];
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const PAW_D = [
  { cx: 12, cy: 15, rx: 4.3, ry: 5.8 },
  { cx: 21, cy: 10, rx: 4.3, ry: 6 },
  { cx: 30, cy: 11, rx: 4.3, ry: 6 },
  { cx: 38.5, cy: 16, rx: 4.3, ry: 5.6 },
  { cx: 25, cy: 29, rx: 9.5, ry: 8 },
];
const CHECK =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>';
const widthsFor = (img: ImageMetadata, list: number[]) =>
  list.map((w) => Math.min(w, img.width)).filter((w, i, a) => a.indexOf(w) === i);
---
<Base
  active="home"
  title="Andrea Bellettati — Comportamento & Nutrizione per Cani e Gatti"
  description="Nutrizione e comportamento per cani e gatti: consulenza gratuita di 45 minuti al telefono e un piano di lavoro scritto e firmato, sempre al fianco del tuo veterinario."
  ogTitle="Andrea Bellettati — Il cibo è il primo passo"
  ogDescription="Consulenza gratuita di 45 minuti per il tuo cane o gatto: alimentazione e comportamento, con un piano scritto e firmato."
  ogImage="/assets/hero.jpg"
  ogImageAlt="Andrea Bellettati con la sua bassotta lungo un fiume di montagna"
  ogImageWidth={1440}
  ogImageHeight={1440}
  jsonLd={faqLd}
>
  <!-- HERO — corteccia, serif editoriale, i due flussi in chiaro.
       L'intro è tutta CSS (righe che salgono, foto che si posano). -->
  <section class="hm-hero" data-sticky-from aria-labelledby="hm-title">
    <div class="container hm-hero-grid">
      <div class="hm-hero-copy">
        <span class="eyebrow kicker-rule" data-intro style="--intro-d:0.05s;">Nutrizione e comportamento · cane e gatto</span>
        <h1 class="hm-title intro-lines" id="hm-title">
          <span class="line"><span>Il cibo è il</span></span>
          <span class="line"><span><em>primo passo.</em></span></span>
        </h1>
        <p class="lead hm-lead" data-intro style="--intro-d:0.6s;">
          Ti aiuto a capire cosa mettere nella ciotola del tuo cane e del tuo gatto, e come questo
          cambia il loro comportamento. Sempre al fianco del tuo veterinario.
        </p>
        <div class="hm-ctas" data-intro style="--intro-d:0.75s;">
          <a class="btn btn-cream btn-lg" href="/consulenza-gratuita#questionario">
            Prenota la consulenza gratuita <ArrowIcon size={16} />
          </a>
          <a class="btn btn-accent btn-lg" href="/lavora-con-noi">Lavora con noi</a>
        </div>
        <ul class="hm-facts" data-intro style="--intro-d:0.9s;">
          <li>45 minuti al telefono</li>
          <li>Piano scritto e firmato</li>
          <li>Senza impegno</li>
        </ul>
      </div>

      <div class="hm-hero-visual" aria-hidden="true">
        <div class="photo-frame hm-photo" data-speed="0.05">
          <Image
            src={heroPortrait}
            alt=""
            widths={widthsFor(heroPortrait, [420, 640, 900])}
            sizes="(min-width: 900px) 460px, 86vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="photo-frame hm-photo-2" data-speed="-0.04">
          <Image src={heroDetail} alt="" widths={widthsFor(heroDetail, [240, 480])} sizes="200px" loading="eager" />
        </div>
        <div class="hm-chip">
          <b>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </b>
          <span><strong>Consulenza gratuita</strong><small>45 minuti · al telefono</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- SCEGLI IL PERCORSO — le due porte e, sotto, l'indice di tutto il sito. -->
  <section class="section hm-paths" aria-labelledby="doors-title">
    <div class="container">
      <div class="head-block">
        <span class="eyebrow kicker-rule">Da dove vuoi partire?</span>
        <h2 class="display-lg" id="doors-title">Scegli il tuo <em>primo passo.</em></h2>
      </div>
      <div class="doors stagger" data-reveal>
        <a class="door door--care" href="/consulenza-gratuita#questionario">
          <span class="eyebrow">Per il tuo cane o gatto</span>
          <h3>Consulenza gratuita di 45 minuti</h3>
          <p>
            Compili il questionario, ti richiamo e analizziamo insieme alimentazione e comportamento
            del tuo animale.
          </p>
          <ul class="door-list">
            <li><Fragment set:html={CHECK} />Un piano di lavoro scritto e firmato</li>
            <li><Fragment set:html={CHECK} />Su misura, non un menu uguale per tutti</li>
            <li><Fragment set:html={CHECK} />In accordo con il tuo veterinario</li>
          </ul>
          <span class="door-go">Compila il questionario <b><ArrowIcon size={20} /></b></span>
          <svg class="door-paw" viewBox="0 0 50 44" fill="currentColor" aria-hidden="true">
            {PAW_D.map((e) => <ellipse cx={e.cx} cy={e.cy} rx={e.rx} ry={e.ry} />)}
          </svg>
        </a>
        <a class="door door--work" href="/lavora-con-noi#candidatura">
          <span class="eyebrow">Per chi vuole farne un lavoro</span>
          <h3>Colloquio conoscitivo</h3>
          <p>
            Ami gli animali e ti interessa la nutrizione pet? Ti racconto come funziona il Team e se
            fa per te.
          </p>
          <ul class="door-list">
            <li><Fragment set:html={CHECK} />Formazione e affiancamento</li>
            <li><Fragment set:html={CHECK} />Cosa si fa e come si guadagna, detto chiaro</li>
          </ul>
          <span class="door-go">Richiedi il colloquio <b><ArrowIcon size={20} /></b></span>
          <svg class="door-paw" viewBox="0 0 50 44" fill="currentColor" aria-hidden="true">
            {PAW_D.map((e) => <ellipse cx={e.cx} cy={e.cy} rx={e.rx} ry={e.ry} />)}
          </svg>
        </a>
      </div>

      <nav class="paths-index" data-reveal aria-labelledby="paths-title">
        <div class="paths-index-head">
          <h3 id="paths-title">Oppure esplora</h3>
          <p>Tutto quello che trovi sul sito, a un click da qui.</p>
        </div>
        <ul class="paths-list">
          {
            percorsi.map((p) => (
              <li>
                <a
                  class:list={['path-row', { 'is-wa': p.wa }]}
                  href={p.href}
                  {...p.wa ? { target: '_blank', rel: 'noopener' } : {}}
                >
                  <span class="path-ico" aria-hidden="true" set:html={p.icon} />
                  <span class="path-text">
                    <b>{p.title}</b>
                    <span>{p.text}</span>
                  </span>
                  <span class="path-arrow" aria-hidden="true"><ArrowIcon size={18} /></span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <!-- CHI SONO — la persona dietro la consulenza, con i numeri. -->
  <section class="section hm-about" aria-labelledby="about-title">
    <div class="container hm-about-grid">
      <div class="hm-about-media" data-reveal>
        <div class="photo-frame hm-about-main" data-clip>
          <Image
            src={aboutPhoto}
            alt="Andrea Bellettati al mare con i suoi due cani in braccio"
            widths={widthsFor(aboutPhoto, [480, 720])}
            sizes="(min-width: 900px) 430px, 80vw"
            loading="lazy"
          />
        </div>
        <div class="photo-frame hm-about-side" data-speed="0.08">
          <Image
            src={aboutSide}
            alt="Andrea con il furgone aperto e i cani, pronti a partire in montagna"
            widths={widthsFor(aboutSide, [240, 480])}
            sizes="200px"
            loading="lazy"
          />
        </div>
      </div>
      <div class="hm-about-copy">
        <div class="head-block">
          <span class="eyebrow kicker-rule">Chi sono</span>
          <h2 class="display-lg" id="about-title">Ciao, sono <em>Andrea.</em></h2>
        </div>
        <p class="lead">
          Mi occupo di comportamento e nutrizione per cani e gatti. Da anni studio il legame tra
          quello che mangiano e come si comportano.
        </p>
        <p>
          Dal {STATS.teamSince} collaboro con un team di professionisti per portare consapevolezza su
          un tema ancora sottovalutato. Nutrirli bene, insieme a una corretta educazione, è la forma
          più grande di cura.
        </p>
        <ul class="hm-stats" data-reveal>
          <li><b data-count={STATS.teamSince} data-count-from="2000">{STATS.teamSince}</b><span>inizio nel team</span></li>
          <li><b data-count={STATS.posts}>{formatNumber(STATS.posts)}</b><span>contenuti pubblicati</span></li>
          <li><b data-count={STATS.followers}>{formatNumber(STATS.followers)}</b><span>persone mi seguono</span></li>
        </ul>
        <div class="hm-about-links">
          <a class="btn" href="/chi-sono">Conosci la mia storia <ArrowIcon size={15} /></a>
          <a class="text-link" href={IG_URL} target="_blank" rel="noopener">Seguimi su Instagram <ArrowIcon size={14} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- L'APPROCCIO — la frase si accende parola per parola con lo scroll -->
  <section class="statement-band" aria-labelledby="st-title">
    <div class="container">
      <span class="eyebrow kicker-rule">L'approccio</span>
      <h2 class="statement" id="st-title" data-scrub>
        Non parto dal prodotto. Parto dall'animale. Alimentazione, comportamento e stile di vita
        fanno parte dello stesso equilibrio.
      </h2>
      <div class="statement-foot">
        <div class="photo-frame statement-photo" data-speed="-0.1">
          <Image
            src={approccioPhoto}
            alt="Andrea Bellettati seduto su una roccia con la sua bassotta, lungo un fiume di montagna"
            widths={widthsFor(approccioPhoto, [320, 640])}
            sizes="300px"
            loading="lazy"
          />
        </div>
        <div class="statement-copy" data-reveal>
          <p>
            Il mio lavoro è osservare il soggetto nella sua globalità e costruire un percorso
            sostenibile per lui e per la sua famiglia.
          </p>
          <p>
            <strong>Lavoro al fianco del tuo veterinario, mai al suo posto.</strong> L'alimentazione è
            il primo passo, non l'unico.
          </p>
          <ul class="st-values" aria-label="I miei valori">
            <li>Concretezza</li>
            <li>Vicinanza</li>
            <li>Scienza semplice</li>
            <li>Rispetto</li>
          </ul>
          <div class="statement-links">
            <a class="btn btn-cream" href="/approccio">Scopri il mio approccio <ArrowIcon size={15} /></a>
            <a class="btn btn-ghost-cream" href="/servizi">I servizi</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COME FUNZIONA — quattro passi su un binario che si riempie con lo
       scroll; la zampina lo percorre (data-rail). -->
  <section class="section hm-how" id="come-funziona" aria-labelledby="how-title">
    <div class="container">
      <div class="head-block">
        <span class="eyebrow kicker-rule">Come funziona la consulenza</span>
        <h2 class="display-lg" id="how-title">Dal questionario al piano, <em>passo dopo passo.</em></h2>
      </div>
      <div class="how-rail" data-rail>
        <span class="how-line" aria-hidden="true">
          <span class="how-fill"></span>
          <span class="how-walker">
            <svg viewBox="0 0 50 44" fill="currentColor">
              {PAW_D.map((e) => <ellipse cx={e.cx} cy={e.cy} rx={e.rx} ry={e.ry} />)}
            </svg>
          </span>
        </span>
        <ol class="how-steps">
          {
            passi.map((p, i) => (
              <li class="how-step" data-rail-step>
                <span class="how-dot" aria-hidden="true" set:html={p.icon} />
                <div class="how-text">
                  <span class="how-n">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="hm-how-foot" data-reveal>
        <a class="btn btn-lg" href="/consulenza-gratuita#questionario">Compila il questionario <ArrowIcon size={16} /></a>
        <span class="hm-how-note">Gratuita · senza impegno · per cane e gatto</span>
      </div>
    </div>
  </section>

  <!-- STORIE VERE — carosello nativo (swipe, frecce): prima/dopo da
       trascinare, foto con la durata, la chat di Brownie che si scrive da sola. -->
  <section class="hm-stories" id="storie" data-sv aria-labelledby="stories-title">
    <div class="container hm-stories-head">
      <div class="head-block">
        <span class="eyebrow kicker-rule">Storie vere</span>
        <h2 class="display-lg" id="stories-title">Cani veri, <em>ciotole vere.</em></h2>
        <p class="lead">
          Ogni storia dice quanto è durata e da dove si partiva. Sono esperienze individuali, non
          promesse.
        </p>
      </div>
      <div class="sv-nav">
        <span class="sv-count" data-sv-count aria-live="polite">1 / 3</span>
        <button class="sv-arrow" type="button" data-sv-prev aria-label="Storia precedente">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <button class="sv-arrow" type="button" data-sv-next aria-label="Storia successiva">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
    </div>

    <div class="sv-track" data-sv-track tabindex="0" aria-label="Storie vere: scorri per vederle tutte">
      <article class="sv-card" aria-labelledby="sv-zoe">
        <div class="sv-media">
          <div class="sv-compare" data-compare>
            {
              zoeDopo ? (
                <Image src={zoeDopo} alt="Zoe dopo un mese di nuova alimentazione" widths={[480]} sizes="(min-width: 820px) 480px, 86vw" loading="lazy" />
              ) : (
                <span class="sv-ph"><span>Foto “dopo un mese” in arrivo</span></span>
              )
            }
            {
              zoePrima ? (
                <Image src={zoePrima} alt="Zoe all'inizio del percorso" widths={[480]} sizes="(min-width: 820px) 480px, 86vw" loading="lazy" class="is-before" />
              ) : (
                <span class="sv-ph sv-ph--b is-before"><span>Foto “prima” in arrivo</span></span>
              )
            }
            <span class="sv-lab sv-lab--l" aria-hidden="true">Prima</span>
            <span class="sv-lab sv-lab--r" aria-hidden="true">Dopo un mese</span>
            <span class="sv-handle" aria-hidden="true">
              <b>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </b>
            </span>
            <input type="range" min="0" max="100" value="50" aria-label="Confronta prima e dopo: trascina" />
          </div>
        </div>
        <div class="sv-body">
          <span class="pill">Prima e dopo</span>
          <h3 id="sv-zoe">Zoe, un mese dopo</h3>
          <p>
            Cucciola dal pelo riccio, appena cambiata l'alimentazione. Dopo trenta giorni il mantello
            racconta già un'altra storia.
          </p>
          <dl class="sv-facts">
            <div><dt>Durata</dt><dd>1 mese</dd></div>
            <div><dt>Percorso</dt><dd>Nuova alimentazione</dd></div>
          </dl>
          <p class="sv-disc">Esperienza individuale. Trascina la linea per confrontare.</p>
        </div>
      </article>

      <article class="sv-card" aria-labelledby="sv-pelle">
        <div class="sv-media">
          <div class="sv-photo">
            {
              pelleFoto ? (
                <Image src={pelleFoto} alt="Un pastore australiano su un prato dopo sei mesi di percorso" widths={[Math.min(480, pelleFoto.width)]} sizes="(min-width: 820px) 480px, 86vw" loading="lazy" />
              ) : (
                <span class="sv-ph"><span>Foto “dopo sei mesi” in arrivo</span></span>
              )
            }
            <span class="sv-badge"><b>6</b> mesi</span>
          </div>
        </div>
        <div class="sv-body">
          <span class="pill">Prima e dopo</span>
          <h3 id="sv-pelle">La pelle racconta</h3>
          <p>
            Sei mesi di tempo e costanza. Quello che succede dentro, prima o poi, si vede fuori: nel
            pelo, nella pelle, nell'energia.
          </p>
          <dl class="sv-facts">
            <div><dt>Durata</dt><dd>6 mesi</dd></div>
            <div><dt>Focus</dt><dd>Pelle e mantello</dd></div>
          </dl>
          <p class="sv-disc">Esperienza individuale.</p>
        </div>
      </article>

      <article class="sv-card" aria-labelledby="sv-brownie">
        <div class="sv-media">
          <div class="sv-chat" data-chat>
            <p class="sv-chat-head">
              <span class="sv-chat-av" aria-hidden="true">
                <svg viewBox="0 0 50 44" fill="currentColor">
                  {PAW_D.map((e) => <ellipse cx={e.cx} cy={e.cy} rx={e.rx} ry={e.ry} />)}
                </svg>
              </span>
              La famiglia di Brownie
            </p>
            <p class="sv-bub" style="--i:0">Dimenticavo… <time>22:11</time></p>
            <p class="sv-bub" style="--i:1">Brownie negativo al test giardia <time>22:11</time></p>
            <p class="sv-bub" style="--i:2">Eseguito qualche settimana fa <time>22:12</time></p>
          </div>
        </div>
        <div class="sv-body">
          <span class="pill pill-sage">La vostra esperienza</span>
          <h3 id="sv-brownie">Brownie e la giardia</h3>
          <p>
            Un messaggio arrivato una sera, a percorso avviato: test negativo al controllo dopo due
            mesi.
          </p>
          <dl class="sv-facts">
            <div><dt>Durata</dt><dd>2 mesi</dd></div>
            <div><dt>Profilo</dt><dd>Cane adulto, asintomatico</dd></div>
          </dl>
          <p class="sv-disc">
            Esperienza individuale, non prova di efficacia terapeutica. La giardia si gestisce sempre
            con il veterinario.
          </p>
        </div>
      </article>
    </div>

    <div class="container sv-foot">
      <div class="sv-dots" data-sv-dots aria-hidden="true"><i class="on"></i><i></i><i></i></div>
      <a class="text-link" href="/consulenza-gratuita#questionario">Inizia anche tu dal questionario <ArrowIcon size={14} /></a>
    </div>
  </section>

  <!-- PROSSIMO INCONTRO — la pagina di calendario, dalla collection eventi. -->
  {
    prossimo && (
      <section class="section-tight hm-event" aria-labelledby="evt-title">
        <div class="container">
          <div class="head-block">
            <span class="eyebrow kicker-rule">Dal vivo e online</span>
            <h2 class="display-md" id="evt-title">Prossimo incontro</h2>
          </div>
          <article class="evt" data-reveal>
            {prossimo.data.date && prossimo.data.status === 'upcoming' ? (
              <div class="evt-date" aria-hidden="true">
                <span class="m">{eventMonthTime(prossimo.data.date).split(' · ')[0]}</span>
                <span class="d">{eventDay(prossimo.data.date)}</span>
                <span class="t">{eventMonthTime(prossimo.data.date).split(' · ')[1]}</span>
              </div>
            ) : (
              <div class="evt-date is-label" aria-hidden="true">
                <span class="m">Data</span>
                <span class="d">{prossimo.data.whenLabel ?? 'In arrivo'}</span>
              </div>
            )}
            <div class="evt-body">
              {prossimo.data.statusLabel && <span class="pill">{prossimo.data.statusLabel}</span>}
              <h3>{prossimo.data.title}</h3>
              <p>{prossimo.data.excerpt}</p>
              <ul class="evt-meta">
                {prossimo.data.locationLabel && (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-5.4-6.5-11a6.5 6.5 0 0 1 13 0c0 5.6-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
                    {prossimo.data.locationLabel}
                  </li>
                )}
                {prossimo.data.collab && (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><circle cx="16.5" cy="9.5" r="2.5"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M14.5 18.5a4 4 0 0 1 6 0"/></svg>
                    {prossimo.data.collab}
                  </li>
                )}
                {prossimo.data.duration && (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    {prossimo.data.duration}
                  </li>
                )}
                {prossimo.data.free && (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>
                    Gratuito
                  </li>
                )}
              </ul>
              <div class="evt-act">
                {prossimoHref && (
                  <a class="btn" href={prossimoHref} {...(prossimoEsterno ? { target: '_blank', rel: 'noopener' } : {})}>
                    {prossimoEsterno ? 'Resta aggiornato' : 'Dettagli e prenotazione'} <ArrowIcon size={15} />
                  </a>
                )}
                <a class="text-link" href="/eventi">Tutti gli eventi <ArrowIcon size={14} /></a>
              </div>
            </div>
          </article>
        </div>
      </section>
    )
  }

  <!-- BLOG — gli ultimi articoli in griglia su desktop, carosello a swipe su telefono. -->
  {
    latestArticoli.length > 0 && (
      <section class="h-blog h-blog--grid" aria-labelledby="blog-title">
        <div class="container h-blog-head">
          <div class="head-block">
            <span class="eyebrow kicker-rule">Dal blog</span>
            <h2 class="display-lg" id="blog-title">
              Senza slogan.
              <br />
              Con <em>metodo.</em>
            </h2>
          </div>
          <a class="btn btn-ghost" href="/articoli">
            Tutti gli articoli <ArrowIcon size={15} />
          </a>
        </div>
        <div class="hs-viewport">
          <div class="hs-track stagger" data-reveal>
            {latestArticoli.map((entry) => (
              <div class="hs-item">
                <ArticleCard entry={entry} />
              </div>
            ))}
            <a class="hs-item hs-more" href="/articoli">
              <span class="hs-more-n">{nArticoli}</span>
              <span class="hs-more-t">articoli per nutrire bene cane e gatto</span>
              <span class="hs-more-cta">
                Vai al blog <ArrowIcon size={18} />
              </span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ — i dubbi prima di compilare; si aprono con un'animazione morbida
       (data-accordion), senza script restano <details> nativi. -->
  <section class="section hm-faq" id="domande" aria-labelledby="faq-title">
    <div class="container hm-faq-grid">
      <div class="hm-faq-head">
        <div class="head-block">
          <span class="eyebrow kicker-rule">Domande frequenti</span>
          <h2 class="display-lg" id="faq-title">Prima di <em>compilare.</em></h2>
        </div>
        <p>Non trovi la tua domanda? Scrivimi: ti rispondo io, di persona.</p>
        <a
          class="btn btn-ghost"
          href={waLink('Ciao Andrea! Ho una domanda sulla consulenza gratuita.')}
          target="_blank"
          rel="noopener"
        >
          <WhatsAppIcon size={16} /> Fammi una domanda
        </a>
      </div>
      <div class="faq" data-reveal>
        {
          faqs.map((f) => (
            <details class="faq-item" data-accordion>
              <summary>
                <span>{f.q}</span>
                <i class="faq-ico" aria-hidden="true" />
              </summary>
              <div class="faq-a" data-accordion-body>
                <div class="faq-a-in">
                  <p>{f.a}</p>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA — corteccia, i due flussi un'ultima volta. -->
  <section class="h-cta" data-sticky-until aria-labelledby="cta-title">
    <div class="container h-cta-inner">
      <span class="eyebrow kicker-rule">Il primo passo è gratuito</span>
      <h2 class="h-cta-title" id="cta-title" data-split="lines">
        Partiamo <em>dalla ciotola.</em>
      </h2>
      <p class="lead">
        45 minuti insieme per analizzare alimentazione e comportamento. Al termine ricevi un piano
        di lavoro scritto e firmato. Senza impegno.
      </p>
      <div class="cta-row">
        <a class="btn btn-cream btn-lg" href="/consulenza-gratuita#questionario">Prenota la consulenza gratuita <ArrowIcon size={16} /></a>
        <a class="btn btn-accent btn-lg" href="/lavora-con-noi#candidatura">Lavora con noi</a>
        <a
          class="text-link"
          href={waLink('Ciao Andrea! Vorrei informazioni sulla consulenza gratuita.')}
          target="_blank"
          rel="noopener"
        >
          <WhatsAppIcon size={15} /> Oppure scrivimi su WhatsApp
        </a>
      </div>
    </div>
    <svg class="h-cta-paw" viewBox="0 0 50 44" fill="currentColor" aria-hidden="true">
      {PAW_D.map((e) => <ellipse cx={e.cx} cy={e.cy} rx={e.rx} ry={e.ry} />)}
    </svg>
  </section>

  <!-- Barra fissa (telefono e tablet): compare dopo l'hero, sparisce sulla CTA finale. -->
  <div class="sticky-bar" data-sticky-cta>
    <a class="btn" href="/consulenza-gratuita#questionario" data-no-roll>Consulenza gratuita</a>
    <a class="btn btn-accent" href="/lavora-con-noi" data-no-roll>Lavora con noi</a>
  </div>
</Base>
