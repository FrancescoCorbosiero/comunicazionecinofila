---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LeafIcon from '../components/LeafIcon.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import CalendarIcon from '../components/CalendarIcon.astro';
import CoverImage from '../components/CoverImage.astro';
import ArticleCard from '../components/ArticleCard.astro';
import heroPhoto from '../assets/hero.jpg';
import chiSonoPhoto from '../assets/chi-sono.jpg';
import { autoCover } from '../lib/images';

// I 3 articoli più recenti pubblicati (con pagina di dettaglio) per l'anteprima blog.
const articoli = await getCollection('articoli');
const latestArticoli = articoli
  .filter((a) => a.data.status === 'published' && !a.data.externalUrl)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const nArticoli = articoli.filter((a) => a.data.status === 'published').length;

// Home-smistatore: due pubblici diversi (famiglie e futuri collaboratori)
// più il blog, serviti da un'unica identità. È IL bivio di conversione.
const paths = [
  {
    num: '01',
    href: '/consulenza-gratuita',
    badge: 'Gratuita · 45 min',
    title: "Voglio migliorare l'alimentazione del mio animale",
    body: 'Analizziamo insieme alimentazione, abitudini e stile di vita del tuo cane o gatto.',
    cta: 'Consulenza gratuita',
    icon: 'paw',
    tone: 'sage',
  },
  {
    num: '02',
    href: '/lavora-con-noi',
    badge: 'TeamNutrizione',
    title: 'Voglio lavorare nel benessere animale',
    body: 'Un Team di persone e professionisti che crescono con un metodo condiviso — non una rete di venditori.',
    cta: 'Lavora con noi',
    icon: 'leaf',
    tone: 'peach',
  },
  {
    num: '03',
    href: '/articoli',
    badge: `${nArticoli} articoli`,
    title: 'Voglio approfondire',
    body: 'Alimentazione, comportamento, intestino, integrazione naturale e vita quotidiana con cani e gatti.',
    cta: 'Leggi il blog',
    icon: 'book',
    tone: 'olive',
  },
];

// Icone line-art delle tre scelte (stroke/fill currentColor, tinte dal tono).
const pathIcons: Record<string, string> = {
  paw: `<svg viewBox="0 0 50 44" width="27" height="24" fill="currentColor" aria-hidden="true"><ellipse cx="12" cy="15" rx="4.3" ry="5.8"/><ellipse cx="21" cy="10" rx="4.3" ry="6"/><ellipse cx="30" cy="11" rx="4.3" ry="6"/><ellipse cx="38.5" cy="16" rx="4.3" ry="5.6"/><ellipse cx="25" cy="29" rx="9.5" ry="8"/></svg>`,
  leaf: `<svg viewBox="0 0 32 32" width="26" height="26" fill="none" aria-hidden="true"><path d="M16 28 C16 16, 22 8, 28 5 C26 14, 22 22, 16 28 Z M16 28 C16 16, 10 8, 4 5 C6 14, 10 22, 16 28 Z M16 28 L16 6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  book: `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true"><path d="M12 6c-2-1.6-5-1.6-8-.5V20c3-1.1 6-1.1 8 .5 2-1.6 5-1.6 8-.5V5.5c-3-1.1-6-1.1-8 .5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M12 6v14.5" stroke="currentColor" stroke-width="1.7"/></svg>`,
};

// Evento in evidenza per il rimando alla pagina Eventi.
const eventi = await getCollection('eventi');
const featuredEvent = eventi.find((e) => e.data.featured) ?? eventi[0];
const ev = featuredEvent?.data;
const evCover = featuredEvent && ev ? autoCover('evento', featuredEvent.id, ev.cover) : undefined;
---
<Base
  active="home"
  title="Andrea Bellettati — Comportamento & Nutrizione per Cani e Gatti"
  description="Comportamento e alimentazione naturale per cani e gatti: consulenza gratuita di 45 minuti e un percorso su misura per il tuo animale."
  ogTitle="Andrea Bellettati — Comportamento & Nutrizione per Cani e Gatti"
  ogDescription="Nutrire bene è la prima forma di cura. Consulenza gratuita e percorso su misura per il tuo animale."
  ogImage="/assets/hero.jpg"
  ogImageAlt="Andrea Bellettati con il suo bassotto lungo un fiume di montagna"
  ogImageWidth={1440}
  ogImageHeight={1440}
>
  <!-- HERO -->
  <section class="hero-center bg-sage paper-bg has-bg" style="background-color:var(--sage);">
    <div class="hero-bg" data-parallax="70" aria-hidden="true">
      <Image
        src={heroPhoto}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={60}
        class="hero-bg-img"
      />
    </div>
    <div class="container">
      <div class="hero-center-inner">
        <span class="hero-portrait-xl" data-parallax="40">
          <img src="/assets/logo.jpg" alt="Andrea Bellettati con il suo bassotto" width="130" height="130" />
        </span>
        <span class="hero-eyebrow">Comportamento &amp; Nutrizione · Cane e Gatto</span>
        <h1 class="hero-title-center">
          <span class="line"><span>Il benessere parte</span></span>
          <span class="line"><span>dalla <span class="hl">ciotola.</span></span></span>
        </h1>
        <p class="hero-lead-c">
          Studio la relazione tra <strong style="color:var(--cream-ink); font-weight:700;"
            >comportamento e alimentazione</strong
          >: non esiste benessere animale senza tenerli insieme. Da qui parte ogni mia consulenza.
        </p>
        <div class="hero-cta-row center">
          <a class="btn btn-lg" href="/consulenza-gratuita">Scopri la consulenza gratuita <ArrowIcon size={16} /></a>
          <button type="button" class="btn btn-ghost-cream btn-lg" data-open-call>
            Richiedi la tua consulenza gratuita <CalendarIcon size={16} />
          </button>
        </div>
        <span class="hero-note">Primo confronto gratuito · cane e gatto</span>
      </div>
    </div>
  </section>

  <!-- SMISTATORE: da dove vuoi iniziare? — IL bivio di conversione -->
  <section class="section bg-paws">
    <div class="container" style="position:relative;">
      <svg class="path-doodle" viewBox="0 0 120 100" aria-hidden="true">
        <path d="M14 8 C64 4, 98 26, 88 74" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
        <path d="M72 62 L88 78 L100 58" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <div class="head-block" data-reveal>
        <span class="eyebrow kicker-rule">Da dove vuoi iniziare?</span>
        <h2 class="display-lg">Dimmi perché<br />sei qui.</h2>
        <p class="lead">
          Due percorsi diversi, un'unica identità: il benessere degli animali. E un blog per
          approfondire con calma.
        </p>
      </div>
      <div class="path-cards" data-deal>
        {
          paths.map((p) => (
            <a class={`path-choice tone-${p.tone}`} href={p.href}>
              <span class="pc-glow" aria-hidden="true" />
              <span class="pc-num" aria-hidden="true">{p.num}</span>
              <span class="pc-top">
                <span class="pc-ico" set:html={pathIcons[p.icon]} />
                <span class="pc-badge">{p.badge}</span>
              </span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <span class="pc-cta">
                {p.cta} <ArrowIcon size={15} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- APPROACH TEASER -->
  <section class="section bg-sage paper-bg edge-tear" style="background-color:var(--sage);">
    <div class="container">
      <div class="split">
        <div class="split-media parallax-cover photo-tape" data-reveal>
          <CoverImage src={heroPhoto} alt="Andrea con il suo bassotto lungo un fiume di montagna" />
        </div>
        <div class="split-body" data-reveal data-delay="1">
          <span class="eyebrow kicker-rule">L'approccio</span>
          <h2 class="display-md">Non parto dal prodotto.<br />Parto dall'animale.</h2>
          <p>
            Alimentazione, comportamento e stile di vita fanno parte dello stesso equilibrio. Il mio
            lavoro è osservare il soggetto nella sua globalità e costruire un percorso sostenibile
            per lui e per la sua famiglia.
          </p>
          <p>
            Dal 2021 collaboro con un team di professionisti uniti per portare consapevolezza su un
            tema troppo spesso sottovalutato.
          </p>
          <div class="hero-cta-row" style="margin-top:6px;">
            <a class="text-link" href="/chi-sono">Conosci la mia storia <ArrowIcon size={14} /></a>
            <a class="text-link" href="/servizi">Scopri i servizi <ArrowIcon size={14} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG PREVIEW -->
  {
    latestArticoli.length > 0 && (
      <section class="section deco-leaf">
        <div class="container">
          <div class="section-head-row" data-reveal>
            <div class="head-block" style="margin-bottom:0;">
              <span class="eyebrow kicker-rule">Dal blog</span>
              <h2 class="display-lg">Senza slogan.<br />Con metodo.</h2>
            </div>
            <a class="btn btn-ghost" href="/articoli">
              Tutti gli articoli <ArrowIcon size={15} />
            </a>
          </div>
          <div class="card-grid cols-3 stagger" data-reveal data-delay="1">
            {latestArticoli.map((entry) => (
              <ArticleCard entry={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- EVENTI TEASER -->
  {
    ev && (
      <section class="section bg-deep paper-bg-deep edge-wave">
        <div class="container">
          <div class="split">
            <div class="split-body" data-reveal>
              <span class="eyebrow kicker-rule">Eventi &amp; webinar</span>
              <h2 class="display-md">Impariamo insieme,<br />dal vivo.</h2>
              <p>
                Incontri gratuiti per imparare a leggere le etichette e nutrire meglio cane e gatto,
                online e in presenza. Come “{ev.title}”: pratici, concreti, senza fronzoli.
              </p>
              {ev.statusLabel && (
                <span class="pill pill-peach" style="align-self:flex-start;">{ev.statusLabel}</span>
              )}
              <div class="hero-cta-row" style="margin-top:8px;">
                <a class="btn btn-cream" href="/eventi">
                  Vedi il calendario <ArrowIcon size={15} />
                </a>
              </div>
            </div>
            <div class="split-media parallax-cover" data-reveal data-delay="1" style="order:-1;">
              {evCover ? (
                <img src={evCover} alt={ev.coverAlt ?? ev.title} loading="lazy" decoding="async" data-parallax data-parallax-cover />
              ) : (
                <CoverImage src={chiSonoPhoto} alt="Andrea Bellettati con il suo cane" />
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- PROOF -->
  <section class="section-tight">
    <div class="container">
      <div class="proof paper-bg-deep stagger" data-reveal>
        <div class="proof-item"><div class="pn">2021</div><div class="pl">Nel team dal</div></div>
        <div class="proof-item"><div class="pn">45'</div><div class="pl">Consulenza gratuita</div></div>
        <div class="proof-item">
          <div class="pn">
            <svg
              viewBox="0 0 50 44"
              width="48"
              height="42"
              fill="var(--peach)"
              aria-hidden="true"
              style="display:inline-block;vertical-align:middle;"
            >
              <ellipse cx="12" cy="15" rx="4.3" ry="5.8"></ellipse>
              <ellipse cx="21" cy="10" rx="4.3" ry="6"></ellipse>
              <ellipse cx="30" cy="11" rx="4.3" ry="6"></ellipse>
              <ellipse cx="38.5" cy="16" rx="4.3" ry="5.6"></ellipse>
              <ellipse cx="25" cy="29" rx="9.5" ry="8"></ellipse>
            </svg>
          </div>
          <div class="pl">Cane &amp; Gatto</div>
        </div>
        <div class="proof-item"><div class="pn">Team</div><div class="pl">Metodo condiviso</div></div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="section bg-deep paper-bg-deep">
    <div class="container container-narrow">
      <div class="cta-band">
        <span class="section-mark" aria-hidden="true">
          <LeafIcon size={40} stroke="var(--peach)" />
        </span>
        <span class="eyebrow">Il primo passo è gratuito</span>
        <h2 class="display-lg">Parliamo del tuo<br />animale, <span class="script">davvero.</span></h2>
        <p class="lead">
          45 minuti insieme per analizzare alimentazione e comportamento. Al termine ricevi un piano
          di lavoro firmato. Senza impegno.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/consulenza-gratuita">Compila il questionario</a>
          <button type="button" class="btn btn-ghost-cream btn-lg" data-open-call>
            Richiedi la tua consulenza gratuita <CalendarIcon size={16} />
          </button>
        </div>
      </div>
    </div>
  </section>
</Base>
