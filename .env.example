# Copia in .env (NON va nel repo) e compila.

# ── Dominio (label di Caddy in docker-compose.yml) ─────────────────
SITE_DOMAIN=andreabellettati.it
SITE_DOMAIN_ALT=www.andreabellettati.it

# ── AWS SES: email dei form ─────────────────────────────────────────
# Regione in cui hai verificato il dominio in SES (es. eu-west-1, eu-south-1).
AWS_REGION=eu-west-1
# Utente IAM con il SOLO permesso ses:SendEmail (vedi README, "Form e AWS SES").
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Mittente su un dominio/indirizzo verificato in SES.
SES_FROM="Sito Comunicazione Cinofila <sito@andreabellettati.it>"
# Chi riceve le richieste (più indirizzi separati da virgola).
SES_TO=andrebellettati@gmail.com
# Facoltativo: configuration set SES per metriche/bounce.
SES_CONFIGURATION_SET=
# true = non invia, stampa l'email nei log (prove/staging).
SES_DRY_RUN=false
